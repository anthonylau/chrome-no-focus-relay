    "background-tab",
    "macos",
    "browser-automation",
    "ai-agent",
    "claude-code",
    "chrome-devtools-mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonylau/chrome-no-focus-relay.git"
  },
  "type": "module",
  "bin": {
    "chrome-no-focus-relay": "relay.mjs"
  },
  "files": [
    "relay.mjs"
  ],
  "scripts": {
    "start": "node relay.mjs",
    "test": "sh test/smoke.sh"
  },
